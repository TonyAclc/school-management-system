NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/school_db?schema=public

# Secrets
JWT_ACCESS_SECRET=access_secret_please_change_me_to_32_chars!
JWT_REFRESH_SECRET=refresh_secret_please_change_me_to_32_chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Limits
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=100kb
